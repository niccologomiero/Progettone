<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="697.0" prefWidth="952.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gomiero.progettonegomiero.controllers.FormController">
    <center>
        <VBox alignment="CENTER">
            <children>
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="245.0" prefWidth="240.0" spacing="15.0">
                    <StackPane>
                        <children>
                            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="350.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
                                <children>
                                    <VBox fx:id="step1" alignment="CENTER" managed="true" maxHeight="-Infinity" maxWidth="-Infinity" spacing="15.0" visible="true">
                                        <children>
                                            <Label style="-fx-font-weight: bold;" text="1. Informazioni di base" />
                                            <Label text="Età:" />
                                            <Spinner fx:id="eta" editable="true" prefWidth="100.0" />
                                            <Label text="Lavoro:" />
                                            <TextArea fx:id="lavoro" prefHeight="50.0" prefWidth="250.0" promptText="Professione..." />
                                            <Label text="Entrate (€):" />
                                            <Spinner fx:id="entrate" editable="true" prefWidth="100.0" />
                                            <CheckBox text="Stabili?" />
                                        </children>
                                    </VBox>

                                    <VBox fx:id="step2" alignment="CENTER" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" spacing="15.0" visible="false">
                                        <children>
                                            <Label style="-fx-font-weight: bold;" text="2. Spese" />
                                            <Label text="Uscite mensili (€):" />
                                            <Spinner fx:id="speseTotali" editable="true" prefWidth="100.0" />
                                            <Label text="Dettaglio spese:" />
                                            <TextArea fx:id="splitSpese" prefHeight="50.0" prefWidth="250.0" promptText="Affitto, cibo, svago..." />
                                            <CheckBox text="Tracci già le spese?" />
                                        </children>
                                    </VBox>

                                    <VBox fx:id="step3" alignment="CENTER" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" spacing="15.0" visible="false">
                                        <children>
                                            <Label style="-fx-font-weight: bold;" text="3. Obiettivi" />
                                            <Label text="Target Risparmio (€):" />
                                            <Spinner fx:id="goalMoney" editable="true" prefWidth="100.0" />
                                            <Label text="Orizzonte (Anni):" />
                                            <Spinner fx:id="goalTime" editable="true" prefWidth="100.0" />
                                            <Label text="Scopo:" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <CheckBox text="Emergenza" />
                                                    <CheckBox text="Acquisto Casa/Auto" />
                                                    <CheckBox text="Viaggi" />
                                                    <CheckBox text="Investire" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </VBox>

                                    <VBox fx:id="step4" alignment="CENTER" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" spacing="15.0" visible="false">
                                        <children>
                                            <Label style="-fx-font-weight: bold;" text="4. Situazione attuale" />
                                            <Label text="Risparmi accumulati (€):" />
                                            <Spinner fx:id="risparmi" editable="true" prefWidth="100.0" />
                                            <CheckBox text="Hai debiti attivi?" />
                                            <TextArea fx:id="debitiDettaglio" prefHeight="50.0" prefWidth="250.0" promptText="Rata mensile o totale..." />
                                            <CheckBox text="Hai già un fondo emergenza?" />
                                        </children>
                                    </VBox>

                                    <VBox fx:id="step5" alignment="CENTER" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" spacing="15.0" visible="false">
                                        <children>
                                            <Label style="-fx-font-weight: bold;" text="5. Comportamento" />
                                            <Label text="Difficoltà a risparmiare:" />
                                            <HBox alignment="CENTER" spacing="10.0">
                                                <children>
                                                    <CheckBox text="Facile" />
                                                    <CheckBox text="Medio" />
                                                    <CheckBox text="Difficile" />
                                                </children>
                                            </HBox>
                                            <Label text="Cosa ti spinge a spendere?" />
                                            <TextArea fx:id="trigger" prefHeight="50.0" prefWidth="250.0" promptText="Impulso, noia..." />
                                            <CheckBox text="Sei costante?" />
                                        </children>
                                    </VBox>

                                    <VBox fx:id="step6" alignment="CENTER" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" spacing="15.0" visible="false">
                                        <children>
                                            <Label style="-fx-font-weight: bold;" text="6. Rischio e Profilo" />
                                            <Label text="Reazione a perdita -10%:" />
                                            <HBox alignment="CENTER" spacing="5.0">
                                                <children>
                                                    <CheckBox text="Vendo" />
                                                    <CheckBox text="Aspetto" />
                                                    <CheckBox text="Investo+" />
                                                </children>
                                            </HBox>
                                            <Label text="Profilo desiderato:" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <CheckBox text="Sicuro (Capitale protetto)" />
                                                    <CheckBox text="Equilibrato" />
                                                    <CheckBox text="Crescita (Aggressivo)" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </VBox>
                                </children>
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                </padding>
                            </VBox>
                        </children>
                    </StackPane>
                    <HBox prefHeight="100.0" prefWidth="200.0" spacing="180.0">
                        <children>
                            <Button disable="true" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="10.0" prefWidth="0.0" style="-fx-background-color: trasparent;">
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                        <image>
                                            <Image url="@../Images/arrow-left.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="10.0" prefWidth="0.0" style="-fx-background-color: trasparent;">
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                        <image>
                                            <Image url="@../Images/arrow-right.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </children>
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </center>
    <left>
        <VBox alignment="CENTER" prefHeight="697.0" prefWidth="52.0" spacing="12.0" style="-fx-background-color: #2e362e;">
            <VBox alignment="CENTER" prefHeight="38.0" prefWidth="36.0">
                <children>
                    <Button fx:id="btn_GoLogout" onAction="#ReturnPage" style="-fx-background-color: trasaparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-log_out.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Log out" textFill="RED">
                        <font>
                            <Font size="10.0" />
                        </font>
                    </Label>
                </children>
                <effect>
                    <DropShadow spread="0.5">
                        <color>
                            <Color red="1.0" />
                        </color>
                    </DropShadow>
                </effect>
            </VBox>
            <padding>
                <Insets bottom="50.0" />
            </padding>
        </VBox>
    </left>
</BorderPane>
