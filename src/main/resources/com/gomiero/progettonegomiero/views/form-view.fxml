<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="containerInit" prefHeight="697.0" prefWidth="952.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gomiero.progettonegomiero.controllers.FormController">
    <center>
        <VBox alignment="CENTER">
            <children>
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="245.0" prefWidth="240.0" spacing="15.0">
                    <StackPane prefHeight="400.0" prefWidth="350.0">
                        <children>
                            <!-- Step 1 -->
                            <VBox fx:id="step1" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="350.0" spacing="15.0">
                                <children>
                                    <Label style="-fx-font-weight: bold;" text="1. Informazioni di base" />
                                    <Label text="Età:" />
                                    <Spinner fx:id="eta" editable="true" prefWidth="100.0">
                                        <valueFactory>
                                            <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="1" initialValue="30" max="100" min="18" />
                                        </valueFactory>
                                    </Spinner>
                                    <Label text="Lavoro:" />
                                    <TextArea fx:id="lavoro" prefHeight="50.0" prefWidth="250.0" promptText="Professione..." />
                                    <Label text="Entrate (€):" />
                                    <Spinner fx:id="entrate" editable="true" prefWidth="100.0">
                                        <valueFactory>
                                            <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="50" initialValue="30" max="10000" min="0" />
                                        </valueFactory>
                                    </Spinner>
                                    <CheckBox text="Stabili?" />
                                </children>
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                </padding>
                            </VBox>

                            <!-- Step 2 -->
                            <VBox fx:id="step3" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="350.0" spacing="15.0" visible="false">
                                <children>
                                    <Label style="-fx-font-weight: bold;" text="2. Spese" />
                                    <Label text="Uscite mensili (€):" />
                                    <Spinner fx:id="speseTotali" editable="true" prefWidth="100.0">
                                        <valueFactory>
                                            <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="50" initialValue="500" max="10000" min="0" />
                                        </valueFactory>
                                    </Spinner>
                                    <CheckBox text="Tracci già le wallet?" />
                                </children>
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                </padding>
                            </VBox>

                            <!-- Step 3 -->
                            <VBox fx:id="step4" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="350.0" spacing="15.0" visible="false">
                                <children>
                                    <Label style="-fx-font-weight: bold;" text="3. Obiettivi" />
                                    <Label text="Target Risparmio (€):" />
                                    <Spinner fx:id="goalMoney" editable="true" prefWidth="100.0">
                                        <valueFactory>
                                            <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="100" initialValue="0" max="10000" min="0" />
                                        </valueFactory>
                                    </Spinner>
                                    <Label text="Orizzonte (Anni):" />
                                    <Spinner fx:id="goalTime" editable="true" prefWidth="100.0">
                                        <valueFactory>
                                            <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="1" initialValue="5" max="50" min="0" />
                                        </valueFactory>
                                    </Spinner>
                                    <Label text="Scopi e target:" />
                                    <VBox spacing="5.0">
                                        <children>
                                            <CheckBox fx:id="isfondoEmergenza" text="Emergenza" />

                                            <CheckBox fx:id="isfondoAuto_casa" text="Acquisto Casa/Auto" />

                                            <CheckBox fx:id="isFondoViaggi" text="Viaggi" />

                                            <CheckBox fx:id="isfondoInvestire" text="Investire" />
                                        </children>
                                    </VBox>
                                </children>
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                </padding>
                            </VBox>

                            <!-- Step 4 -->
                            <VBox fx:id="step5" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="350.0" spacing="15.0" visible="false">
                                <children>
                                    <Label style="-fx-font-weight: bold;" text="4. Situazione attuale" />
                                    <Label text="Risparmi accumulati (€):" />
                                    <Spinner fx:id="risparmi" amountToStepBy="100" editable="true" initialValue="0" max="10000" min="0" prefWidth="100.0" />
                                    <CheckBox text="Hai debiti attivi?" />
                                    <Spinner fx:id="debitiDettaglio" amountToStepBy="100" initialValue="0" max="10000" min="0" prefHeight="50.0" prefWidth="250.0" promptText="Rata mensile o totale..." />
                                </children>
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                </padding>
                            </VBox>
                        </children>
                    </StackPane>

                    <HBox alignment="CENTER" prefHeight="28.0" prefWidth="441.0" spacing="50.0">
                        <children>
                            <Button fx:id="btn_before_step" disable="true" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#onChangeStep" prefHeight="10.0" prefWidth="0.0" style="-fx-background-color: transparent;">
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                        <image>
                                            <Image url="@../Images/arrow-left.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="btn_SaveData" onAction="#onSave" text="Salva!" visible="false" />
                            <Button fx:id="btn_next_Step" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#onChangeStep" prefHeight="10.0" prefWidth="0.0" style="-fx-background-color: transparent;">
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                        <image>
                                            <Image url="@../Images/arrow-right.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </children>
                    </HBox>
                </VBox>
                <Label fx:id="showErrors" />
            </children>
        </VBox>
    </center>
    <left>
      <BorderPane style="-fx-background-color: linear-gradient(to bottom right, #2A3A31, #1D2922, #121915);">
         <center>
              <VBox alignment="CENTER" prefHeight="697.0" prefWidth="408.0" spacing="12.0">
               <Label text="Prima di iniziare.." textFill="WHITE">
                  <font>
                     <Font name="Segoe UI Light" size="28.0" />
                  </font>
               </Label>
               <Label text="completa il profilo!" textFill="WHITE">
                  <font>
                     <Font name="Segoe UI Light" size="27.0" />
                  </font>
               </Label>
                  <padding>
                      <Insets bottom="50.0" />
                  </padding>
              </VBox>
         </center>
         <bottom>
               <VBox alignment="CENTER" prefHeight="38.0" prefWidth="36.0" BorderPane.alignment="CENTER">
                   <children>
                       <Button fx:id="btn_GoLogout" onAction="#ReturnPage" style="-fx-background-color: transparent;">
                           <graphic>
                               <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                   <image>
                                       <Image url="@../Images/Icon-log_out.png" />
                                   </image>
                               </ImageView>
                           </graphic>
                       </Button>
                       <Label text="Log out" textFill="RED">
                           <font>
                               <Font size="10.0" />
                           </font>
                       </Label>
                   </children>
                   <effect>
                       <DropShadow spread="0.5">
                           <color>
                               <Color red="1.0" />
                           </color>
                       </DropShadow>
                   </effect>
               <padding>
                  <Insets bottom="10.0" />
               </padding>
               </VBox>
         </bottom>
      </BorderPane>
    </left>
</BorderPane>
