<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="containerInit" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gomiero.progettonegomiero.controllers.NotesController">
    <center>
      <BorderPane fx:id="contenutoNote">
         <center>
            <Pane prefHeight="697.0" prefWidth="1080.0" BorderPane.alignment="CENTER" />
         </center>
         <top>
            <Label text="Note di" BorderPane.alignment="CENTER">
               <font>
                  <Font name="Corbel Light" size="32.0" />
               </font>
            </Label>
         </top></BorderPane>
    </center>
    <left>
        <VBox alignment="CENTER" prefHeight="697.0" prefWidth="52.0" spacing="12.0" style="-fx-background-color: #2e362e;">
            <VBox alignment="CENTER" prefHeight="38.0" prefWidth="36.0">
                <children>
                    <Button onAction="#ReturnPage" style="-fx-background-color: transparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-log_out.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Log out" textFill="RED">
                        <font>
                            <Font size="10.0" />
                        </font>
                    </Label>
                </children>
                <effect>
                    <DropShadow spread="0.5">
                        <color>
                            <Color red="1.0" />
                        </color>
                    </DropShadow>
                </effect>
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
            </VBox>
            <VBox alignment="CENTER" prefHeight="2.0" prefWidth="0.0">
                <children>
                    <Button onAction="#ReturnPage" style="-fx-background-color: transparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-graph.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Graph">
                        <font>
                            <Font size="10.0" />
                        </font>
                    </Label>
                </children>
                <effect>
                    <DropShadow spread="0.5">
                        <color>
                            <Color red="1.0" green="1.0" blue="1.0" />
                        </color>
                    </DropShadow>
                </effect>
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
            </VBox>
            <VBox alignment="CENTER" prefHeight="47.0" prefWidth="46.0">
                <children>
                    <Button onAction="#ReturnPage" style="-fx-background-color: transparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="25.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-casa.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Home">
                        <font>
                            <Font size="10.0" />
                        </font></Label>
                </children>
                <effect>
                    <DropShadow spread="0.5">
                  <color>
                     <Color red="1.0" green="1.0" blue="1.0" />
                  </color></DropShadow>
                </effect>
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
            </VBox>
            <padding>
                <Insets bottom="50.0" />
            </padding>
        </VBox>
    </left>
   <effect>
      <DropShadow />
   </effect>
</BorderPane>
