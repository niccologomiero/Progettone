<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="697.0" prefWidth="1151.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gomiero.progettonegomiero.controllers.HomeController">
   <center>
       <VBox fx:id="containerInit" alignment="TOP_CENTER" prefHeight="697.0" prefWidth="670.0" spacing="5.0" style="-fx-background-color: #f5f5f5;">
         <children>
            <VBox alignment="CENTER" prefHeight="32.0" prefWidth="1145.0">
               <children>
                  <Label fx:id="welcomeUser" prefHeight="27.0" prefWidth="105.0" text="\@user'Home">
                     <font>
                        <Font name="Segoe UI Light" size="18.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="361.0" prefWidth="1145.0" spacing="40.0">
               <children>
                  <VBox prefHeight="361.0" prefWidth="443.0" style="-fx-background-color: #f2f2f2; -fx-background-radius: 9px; -fx-border-radius: 9px; -fx-border-color: transparent;">

                      <effect>
                          <DropShadow spread="0.2">
                              <color>
                                  <Color red="0.6899999976158142" green="0.6899999976158142" blue="0.6899999976158142" />
                              </color>
                          </DropShadow>
                      </effect>
                  </VBox>
                  <VBox prefHeight="360.0" prefWidth="216.0" style="-fx-background-color: #f2f2f2; -fx-background-radius: 9px; -fx-border-radius: 9px; -fx-border-color: transparent;">

                      <effect>
                          <DropShadow spread="0.2">
                              <color>
                                  <Color red="0.6899999976158142" green="0.6899999976158142" blue="0.6899999976158142" />
                              </color>
                          </DropShadow>
                      </effect>
                  </VBox>
               </children>
            </HBox>
            <VBox alignment="CENTER" prefHeight="308.0" prefWidth="1145.0">

               <children>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" style="-fx-background-color:#f2f2f2; -fx-background-radius: 9px; -fx-border-radius: 9px; -fx-border-color: transparent;">
                      <effect>
                          <DropShadow spread="0.2">
                              <color>
                                  <Color red="0.6899999976158142" green="0.6899999976158142" blue="0.6899999976158142" />
                              </color>
                          </DropShadow>
                      </effect>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="5.0" left="10.0" />
         </padding>

       </VBox>
   </center>
   <right>
       <VBox alignment="CENTER" prefHeight="697.0" prefWidth="306.0" BorderPane.alignment="CENTER">
           <children>
            <HBox alignment="CENTER_RIGHT" prefHeight="903.0" prefWidth="306.0">
               <children>
                   <Button fx:id="btn_backPiechart" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#onChangePiechart" prefHeight="10.0" prefWidth="0.0" style="-fx-background-color: transparent;">
                       <graphic>
                           <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                               <image>
                                   <Image url="@../Images/arrow-left.png" />
                               </image>
                           </ImageView>
                       </graphic>
                   </Button>
                  <VBox style="-fx-background-color: #f2f2f2; -fx-background-radius: 9px; -fx-border-radius: 9px; -fx-border-color: transparent;">
                     <children>
                         <StackPane>
                         <PieChart fx:id="pieChartBudget"  prefHeight="267.0" prefWidth="234.0"  title="Grafico"/>
                             <PieChart fx:id="pieChartAverageBills" visible="false" prefHeight="267.0" prefWidth="234.0"/>
                             <PieChart fx:id="pieChartDetailsBills" visible="true" prefHeight="267.0" prefWidth="234.0"/>

                         </StackPane>
                     </children>
                      <effect>
                          <DropShadow spread="0.2">
                              <color>
                                  <Color red="0.6899999976158142" green="0.6899999976158142" blue="0.6899999976158142" />
                              </color>
                          </DropShadow>
                      </effect>
                  </VBox>
                   <Button fx:id="btn_nextPiechart" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#onChangePiechart" prefHeight="10.0" prefWidth="0.0" style="-fx-background-color: transparent;">
                       <graphic>
                           <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                               <image>
                                   <Image url="@../Images/arrow-right.png" />
                               </image>
                           </ImageView>
                       </graphic>
                   </Button>
               </children>
            </HBox>
           </children>
         <padding>
            <Insets bottom="30.0" top="30.0" />
         </padding>
       </VBox>
   </right>

    <left>
        <VBox alignment="CENTER" prefHeight="697.0" prefWidth="52.0" spacing="12.0" style="-fx-background-color: linear-gradient(to bottom right, #2A3A31, #1D2922, #121915);">
            <VBox alignment="CENTER" prefHeight="38.0" prefWidth="36.0">
                <children>
                    <Button fx:id="btn_GoLogout" onAction="#ReturnPage" style="-fx-background-color: trasaparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-log_out.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Log out" textFill="RED">
                        <font>
                            <Font size="10.0" />
                        </font>
                    </Label>
                </children>
                <effect>
                    <DropShadow spread="0.5">
                        <color>
                            <Color red="1.0" />
                        </color>
                    </DropShadow>
                </effect>
            </VBox>
            <VBox alignment="CENTER" prefHeight="2.0" prefWidth="0.0">
                <children>
                    <Button fx:id="btn_GoGraph" onAction="#ReturnPage" style="-fx-background-color: trasparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-graph.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Graph">
                        <font>
                            <Font size="10.0" />
                        </font>
                    </Label>
                </children>
                <effect>
                    <DropShadow spread="0.5">
                        <color>
                            <Color red="1.0" green="1.0" blue="1.0" />
                        </color>
                    </DropShadow>
                </effect>
            </VBox>
            <VBox alignment="CENTER" prefHeight="47.0" prefWidth="46.0">
                <children>
                    <Button fx:id="btn_GoNotes" onAction="#goToNotes" style="-fx-background-color: trasparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-notes.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Notes">
                        <font>
                            <Font size="10.0" />
                        </font></Label>
                </children>
                <effect>
                    <DropShadow spread="0.55">
                        <color>
                            <Color red="1.0" green="1.0" blue="1.0" />
                        </color></DropShadow>
                </effect>
            </VBox>
            <padding>
                <Insets bottom="50.0" />
            </padding>
        </VBox>
    </left>
</BorderPane>
