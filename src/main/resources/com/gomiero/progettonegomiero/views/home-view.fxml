<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="697.0" prefWidth="1151.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gomiero.progettonegomiero.controllers.HomeController">
   <center>
       <VBox fx:id="containerInit" alignment="TOP_CENTER" prefHeight="697.0" prefWidth="670.0" style="-fx-background-color: #f5f5f5;">
         <children>
            <VBox alignment="CENTER" prefHeight="32.0" prefWidth="1145.0">
               <children>
                  <Label fx:id="welcomeUser" prefHeight="27.0" prefWidth="105.0" text="\@user'Home">
                     <font>
                        <Font name="Segoe UI Light" size="18.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="361.0" prefWidth="1145.0" spacing="40.0" style="-fx-background-color: red;">
               <children>
                  <VBox prefHeight="361.0" prefWidth="443.0" style="-fx-background-color: blue;" />
                  <VBox prefHeight="360.0" prefWidth="216.0" style="-fx-background-color: blue;" />
               </children>
            </HBox>
            <VBox prefHeight="308.0" prefWidth="1145.0" style="-fx-background-color: purple;" />
         </children>

       </VBox>
   </center>
   <right>
       <VBox alignment="CENTER" prefHeight="697.0" prefWidth="306.0" BorderPane.alignment="CENTER">
           <children>
               <Pane prefHeight="694.0" prefWidth="200.0" style="-fx-background-color: green;">
                   <children>
                       <PieChart fx:id="pieChart"  prefHeight="478.0" prefWidth="306.0" style="-fx-background-color: white;" title="Grafico" />
                   </children></Pane>
           </children>
       </VBox>
   </right>

    <left>
        <VBox alignment="CENTER" prefHeight="697.0" prefWidth="52.0" spacing="12.0" style="-fx-background-color: #2e362e;">
            <VBox alignment="CENTER" prefHeight="38.0" prefWidth="36.0">
                <children>
                    <Button fx:id="btn_GoLogout" onAction="#ReturnPage" style="-fx-background-color: trasaparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-log_out.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Log out" textFill="RED">
                        <font>
                            <Font size="10.0" />
                        </font>
                    </Label>
                </children>
                <effect>
                    <DropShadow spread="0.5">
                        <color>
                            <Color red="1.0" />
                        </color>
                    </DropShadow>
                </effect>
            </VBox>
            <VBox alignment="CENTER" prefHeight="2.0" prefWidth="0.0">
                <children>
                    <Button fx:id="btn_GoGraph" onAction="#ReturnPage" style="-fx-background-color: trasparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-graph.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Graph">
                        <font>
                            <Font size="10.0" />
                        </font>
                    </Label>
                </children>
                <effect>
                    <DropShadow spread="0.5">
                        <color>
                            <Color red="1.0" green="1.0" blue="1.0" />
                        </color>
                    </DropShadow>
                </effect>
            </VBox>
            <VBox alignment="CENTER" prefHeight="47.0" prefWidth="46.0">
                <children>
                    <Button fx:id="btn_GoNotes" onAction="#goToNotes" style="-fx-background-color: trasparent;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                                <image>
                                    <Image url="@../Images/Icon-notes.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label text="Notes">
                        <font>
                            <Font size="10.0" />
                        </font></Label>
                </children>
                <effect>
                    <DropShadow spread="0.55">
                        <color>
                            <Color red="1.0" green="1.0" blue="1.0" />
                        </color></DropShadow>
                </effect>
            </VBox>
            <padding>
                <Insets bottom="50.0" />
            </padding>
        </VBox>
    </left>
</BorderPane>
