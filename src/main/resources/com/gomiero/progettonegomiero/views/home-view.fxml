<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gomiero.progettonegomiero.controllers.HomeController">
   <center>
       <VBox fx:id="containerInit" alignment="TOP_CENTER" prefHeight="697.0" prefWidth="1145.0" spacing="40.0" style="-fx-background-color: #f5f5f5;">
           <padding>
               <Insets top="20.0" />
           </padding>
           <GridPane alignment="CENTER" layoutX="35.0" layoutY="14.0" prefHeight="386.0" prefWidth="1145.0">
               <columnConstraints>
                   <ColumnConstraints hgrow="SOMETIMES" maxWidth="481.0" minWidth="10.0" prefWidth="356.0" />
                   <ColumnConstraints hgrow="SOMETIMES" maxWidth="493.0" minWidth="10.0" prefWidth="493.0" />
               </columnConstraints>
               <rowConstraints>
                   <RowConstraints maxHeight="161.0" minHeight="0.0" prefHeight="0.0" vgrow="SOMETIMES" />
                   <RowConstraints maxHeight="332.0" minHeight="10.0" prefHeight="272.0" vgrow="SOMETIMES" />
                   <RowConstraints maxHeight="332.0" minHeight="10.0" prefHeight="26.0" vgrow="SOMETIMES" />
                   <RowConstraints maxHeight="213.0" minHeight="10.0" prefHeight="89.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                   <AnchorPane prefHeight="200.0" prefWidth="200.0" GridPane.rowIndex="1" />
               </children>

           </GridPane>

       </VBox>
   </center>
    <left>
        <VBox alignment="CENTER" prefHeight="697.0" prefWidth="52.0" spacing="12.0" style="-fx-background-color: #2e362e;">
         <VBox alignment="CENTER" prefHeight="38.0" prefWidth="36.0">
            <children>
                  <Button fx:id="btn_GoLogout" onAction="#ReturnPage" style="-fx-background-color: trasaparent;">
                      <graphic>
                          <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                              <image>
                                  <Image url="@../Images/Icon-log_out.png" />
                              </image>
                          </ImageView>
                      </graphic>
                  </Button>
               <Label text="Log out" textFill="RED">
                  <font>
                     <Font size="10.0" />
                  </font>
               </Label>
            </children>
            <effect>
               <DropShadow spread="0.5">
                  <color>
                     <Color red="1.0" />
                  </color>
               </DropShadow>
            </effect>
         </VBox>
         <VBox alignment="CENTER" prefHeight="2.0" prefWidth="0.0">
            <children>
                  <Button fx:id="btn_GoGraph" onAction="#ReturnPage" style="-fx-background-color: trasparent;">
                      <graphic>
                          <ImageView fitHeight="25.0" fitWidth="20.0" layoutX="6.0" layoutY="138.0" mouseTransparent="true">
                              <image>
                                  <Image url="@../Images/Icon-graph.png" />
                              </image>
                          </ImageView>
                      </graphic>
                  </Button>
               <Label text="Graph">
                  <font>
                     <Font size="10.0" />
