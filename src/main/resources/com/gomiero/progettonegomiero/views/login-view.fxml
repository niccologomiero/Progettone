<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="containerInit" alignment="CENTER" prefHeight="587.0" prefWidth="890.0" spacing="60.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gomiero.progettonegomiero.controllers.Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" alignment="CENTER" prefHeight="72.0" prefWidth="170.0" text="Welcome">
      <font>
         <Font size="32.0" />
      </font></Label>
   <Pane maxHeight="235.0" maxWidth="240.0" prefHeight="235.0" prefWidth="240.0">
      <children>
         <PasswordField fx:id="Password" layoutX="30.0" layoutY="69.0" maxWidth="240.0" prefWidth="180.0" promptText="Password" />
         <TextField fx:id="Email" layoutX="30.0" layoutY="33.0" maxWidth="240.0" prefWidth="180.0" promptText="Email" />
         <Label layoutX="74.0" layoutY="6.0" text="Email e Password" />
          <Button layoutX="49.0" layoutY="138.0" onAction="#onLogInButton" text="Accedi"/>
          <Button layoutX="138.0" layoutY="138.0" onAction="#onSingInButton" text="Registrati" />
      </children>
   </Pane>
    <Label fx:id="ShowError" text="" />
</VBox>
