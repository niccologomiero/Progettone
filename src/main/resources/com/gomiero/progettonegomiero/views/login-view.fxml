<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="containerInit" prefHeight="587.0" prefWidth="890.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gomiero.progettonegomiero.controllers.LoginController">
    <left>
    <VBox alignment="CENTER" prefHeight="587.0" prefWidth="447.0" spacing="100.0" style="-fx-background-color: linear-gradient(to bottom right, #2A3A31, #1D2922, #121915);">
         <children>
            <Label layoutX="103.0" layoutY="137.0" prefHeight="50.0" prefWidth="216.0" text="Benvenuto/a" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Semilight" size="34.0" />
               </font>
            </Label>
            <Label layoutX="14.0" layoutY="243.0" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="76.0" prefWidth="266.0" text="EFFETTUA LA REGISTRAZIONE O L'ACCESSO" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Light" size="14.0" />
               </font>

            </Label>
         </children></VBox>
    </left>
    <right>
        <VBox alignment="CENTER" maxHeight="617.0" maxWidth="488.0" prefHeight="587.0" prefWidth="488.0" spacing="30.0" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="74.0" layoutY="6.0" text="Username e Password">
               <font>
                  <Font name="Segoe UI Light" size="12.0" />
               </font></Label>
                  <TextField fx:id="usernameField" maxWidth="240.0" prefWidth="180.0" promptText="Username" />
                  <PasswordField fx:id="passwordField" maxWidth="240.0" prefWidth="180.0" promptText="Password" />
                <HBox alignment="CENTER" spacing="30">
                    <children>
                        <Button onAction="#onLogInButton" text="Accedi" />
                        <Button onAction="#onSingInButton" text="Registrati" />
                    </children>
                </HBox>
                <Label fx:id="ShowError" text="" />
            </children>
        </VBox>
    </right>
</BorderPane>
